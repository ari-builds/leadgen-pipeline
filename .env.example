# Database
DATABASE_URL=file:./local.db
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-string

# Email Providers (configure one or both — system routes by type)
# GoodSender — transactional (OTP, notifications). 100K/mo free, no domain needed.
GOODSENDER_API_KEY=
# Resend — marketing (campaigns, outreach). Needs domain verification.
RESEND_API_KEY=
EMAIL_FROM=NetClicks <noreply@localhost>

# App
ADMIN_EMAIL=your-email@example.com
